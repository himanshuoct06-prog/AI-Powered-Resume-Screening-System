    {
      "parameters": {
        "sendTo": "={{$node[\"Resume Submission Form\"].json[\"Email\"]}}",
        "subject": "Interview Invitation - Resume Screening",
        "message": "<h2>🎉 Interview Invitation</h2>\n\n<p>Dear Candidate,</p>\n\n<p>\nCongratulations! We are pleased to inform you that your resume has been successfully shortlisted through our\n<b>AI-Powered Resume Screening System</b>.\n</p>\n\n<p>\nBased on the analysis of your skills, experience, and overall profile match against our job requirements,\nyou have been selected to proceed to the next stage of the recruitment process.\n</p>\n\n<hr>\n\n<h3>Interview Details</h3>\n\n<ul>\n  <li><b>Interview Type:</b> Virtual Interview</li>\n  <li><b>Duration:</b> 30 Minutes</li>\n  <li><b>Mode:</b> Online</li>\n</ul>\n\n<h3>Schedule Your Interview</h3>\n\n<p>\nPlease click the link below to book your preferred interview slot:\n</p>\n\n<p>\n<a href=\"https://calendly.com/himanshu-oct06/data-engineer-interview\">\n📅 Book Interview Slot\n</a>\n</p>\n\n<p>\nOnce your interview is scheduled, you will receive a confirmation email containing meeting details.\n</p>\n\n<hr>\n\n<p>\nIf you have any questions or require assistance, please feel free to contact us.\n</p>\n\n<p>\nWe look forward to speaking with you.\n</p>\n\n<br>\n\n<p>\nBest Regards,<br>\n<b>HR Team</b><br>\nAI Resume Screening System<br>\nAutomated Recruitment Platform\n</p>\n\n<hr>\n\n<p style=\"font-size:12px;color:gray;\">\nThis email was generated automatically by the AI Resume Screening Workflow powered by n8n.\n</p>",
